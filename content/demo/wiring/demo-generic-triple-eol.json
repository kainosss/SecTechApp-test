{
  "id": "demo-generic-triple-eol",
  "title": "Triple EOL: alarm and tamper resistors across their contacts, EOL in series",
  "summary": "Each contact has its own resistor across it, so alarm, tamper and a cut cable all give different readings.",
  "inputType": "triple-eol",
  "arrangement": {
    "key": "nc-alarm-nc-tamper",
    "label": "NC alarm + NC tamper"
  },
  "configurationLabel": "2k2 EOL / 2k2 alarm / 4k4 tamper",
  "shortLabel": "Triple EOL",
  "explorerOrder": 2,
  "explorerHidden": true,
  "circuit": {
    "terminals": {
      "a": {
        "label": "Z+",
        "description": "Zone input (generic)"
      },
      "b": {
        "label": "Z−",
        "description": "Zone common (generic)"
      }
    },
    "network": {
      "kind": "series",
      "children": [
        {
          "kind": "parallel",
          "children": [
            {
              "kind": "contact",
              "id": "ALM",
              "function": "alarm",
              "type": "NC"
            },
            {
              "kind": "resistor",
              "id": "R2",
              "ohms": 2200,
              "role": "alarm",
              "purpose": "Alarm resistor, bypassed by the closed alarm contact; added to the loop when the contact opens."
            }
          ]
        },
        {
          "kind": "parallel",
          "children": [
            {
              "kind": "contact",
              "id": "TMP",
              "function": "tamper",
              "type": "NC"
            },
            {
              "kind": "resistor",
              "id": "R3",
              "ohms": 4400,
              "role": "tamper",
              "purpose": "Tamper resistor, bypassed by the closed tamper contact; added to the loop when the tamper opens."
            }
          ]
        },
        {
          "kind": "resistor",
          "id": "R1",
          "ohms": 2200,
          "role": "end-of-line",
          "purpose": "End-of-line (seal) resistor, always in the loop."
        }
      ]
    }
  },
  "states": [
    {
      "id": "normal",
      "kind": "normal",
      "contacts": {
        "ALM": "closed",
        "TMP": "closed"
      }
    },
    {
      "id": "alarm",
      "kind": "alarm",
      "contacts": {
        "ALM": "open",
        "TMP": "closed"
      }
    },
    {
      "id": "tamper",
      "kind": "tamper",
      "contacts": {
        "ALM": "closed",
        "TMP": "open"
      }
    },
    {
      "id": "cable-open",
      "kind": "cable-open",
      "line": "open"
    },
    {
      "id": "cable-short",
      "kind": "cable-short",
      "line": "short"
    }
  ],
  "isDemo": true,
  "verification": {
    "status": "demonstration",
    "notes": "Generic circuit for learning and testing. Not tied to any panel."
  },
  "updatedAt": "2026-10-26"
}
