# Copy to .env.local to change local settings.

# Show fictional demonstration devices, wiring and workflows (development only).
# Never enable in production. `npm run dev:demo` sets this for you.
# FIELDWISE_DEMO_MODE=true

# Not used yet. Later phases (Supabase, Stripe) will read these.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# STRIPE_SECRET_KEY=
