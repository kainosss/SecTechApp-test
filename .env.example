# Copy to .env.local to change local settings. On Vercel, set these under
# Project → Settings → Environment Variables. All values are read at build time.

# Show fictional demonstration devices, wiring and workflows (development only).
# Never enable in production or the pilot. `npm run dev:demo` sets this for you.
# (The demo *site* in the app works without it.)
# FIELDWISE_DEMO_MODE=true

# Optional: a real inbox you control. When set, Feedback offers "Open as email draft".
# NEXT_PUBLIC_ values are public (built into the page) — never put a secret here.
# NEXT_PUBLIC_FEEDBACK_EMAIL=

# Fieldwise has no secrets, API keys or server-side credentials. Pilot access
# protection is configured on the hosting platform, not here (docs/WEB_DEPLOYMENT.md).
